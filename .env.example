# Server (apps/server) — local dev defaults
SERVER_TOKEN=server-token
PORT=8787

# Owner user ID — used to scope all data rows until real auth is added.
# Change this to any string you like; must match between server and sync script.
OWNER_USER_ID=owner

# Optional: absolute path to server's SQLite file.
# Defaults to apps/server/data/server.db when unset.
# DB_PATH=/absolute/path/to/server.db

# Desktop + companion clients
VITE_SERVER_URL=http://localhost:8787
VITE_SERVER_TOKEN=server-token
