# Sync API (apps/sync-api) — local dev defaults
SYNC_API_TOKEN=dev-token
LIBSQL_URL=file:apps/sync-api/data/local.db
PORT=8787

# Turso production example:
# LIBSQL_URL=libsql://your-db-name-org.turso.io
# LIBSQL_AUTH_TOKEN=your-turso-token

# Desktop + companion clients
VITE_SYNC_API_URL=http://localhost:8787
VITE_SYNC_API_TOKEN=dev-token
