{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Management",
  "version": "1.5.1",
  "identifier": "com.diamari.management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Management",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob: data: mediastream:; connect-src 'self' ws://localhost:1430 ws://127.0.0.1:1430 https://cdn.jsdelivr.net https://storage.googleapis.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../locales",
      "./icons"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "fs": {},
    "sql": {
      "preload": [
        "sqlite:posture_data.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMDlDMDJDODcxRDgyOEIKUldTTGdoMkhMTUFKci9Hc296TXJvdSt0Mlp6WFlMYVV1M0hCaXVRVm5ublpIYUxLeEd1R3M0cVEK",
      "endpoints": [
        "https://github.com/diamari/management/releases/latest/download/latest.json"
      ]
    }
  }
}
