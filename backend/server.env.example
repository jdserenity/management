# Copy to /etc/mgmt/server.env on the VPS (chmod 600).
# systemd loads this via EnvironmentFile= in mgmt-server.service.

SERVER_TOKEN=change-me-long-random-string
PORT=8787
DB_PATH=/home/linuxuser/prod-apps/management/data/server.db
# Optional. Default: <dir-of-DB_PATH>/backups (daily snapshots, 14-day retention, in-process).
# BACKUP_DIR=/home/linuxuser/prod-apps/management/data/backups
OWNER_USER_ID=owner

# Optional Cloudflare R2 offsite copy (all four required to enable). Same 14-day retention.
# Account ID: Cloudflare dashboard → right sidebar (or Workers & Pages overview).
# API token: R2 → Manage R2 API Tokens → Create API token (Object Read & Write on the bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mgmt-db-backups
# Optional key prefix inside the bucket (trailing slash optional).
# R2_PREFIX=server/
